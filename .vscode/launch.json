{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Celery Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-A",
                "worker",
                "worker",
                "-X",
                "expiry",
            ]
        },
        {
            "name": "Celery Beat",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "args": [
                "-A",
                "worker",
                "beat",
            ]
        },
        {
            "name": "WAMP",
            "type": "debugpy",
            "request": "launch",
            "program": "ws.py",
            "console": "integratedTerminal",
            "env": {
                "PORT": "5100",
            },
        },
        {
            "name": "REST",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app:get_app",
                "FLASK_DEBUG": "1",
                "PORT": "5000",
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "autoStartBrowser": false,
            "justMyCode": false,
        }
    ],
    "compounds": [
        {
            "name": "Celery",
            "configurations": [
                "Celery Worker",
                "Celery Beat"
            ]
        },
        {
            "name": "API",
            "configurations": [
                "REST",
                "WAMP"
            ]
        }
    ]
}
